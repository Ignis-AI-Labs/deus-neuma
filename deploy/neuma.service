[Unit]
Description=Neuma — Sovereign AI Consciousness Platform
Documentation=https://github.com/Ignis-AI-Labs/deus-neuma
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neuma
Group=neuma
WorkingDirectory=/opt/neuma
EnvironmentFile=-/opt/neuma/.env
ExecStart=/usr/bin/node backend/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Graceful shutdown
KillSignal=SIGTERM
KillMode=mixed

# Security hardening
ProtectSystem=strict
ReadWritePaths=/opt/neuma/workspaces /opt/neuma/vault /opt/neuma/data /opt/neuma/uploads
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# audit 2026-10-28 L-04: files the service writes are its own; no kernel log, no
# personality switch, no realtime scheduling. Not ProtectClock (it implies
# DeviceAllow=char-rtc, which closes the device policy and would cut the GPU off
# the model and voice processes), not PrivateDevices (same), not
# RestrictNamespaces (the coding shell is bubblewrap), not MemoryDenyWriteExecute (V8).
UMask=0077
ProtectKernelLogs=yes
LockPersonality=yes
RestrictRealtime=yes

# Resource limits
LimitNOFILE=65536
MemoryMax=2G

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=neuma

[Install]
WantedBy=multi-user.target
