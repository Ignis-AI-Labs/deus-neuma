{
  "name": "neuma",
  "version": "0.1.98",
  "license": "FSL-1.1-ALv2",
  "description": "Deus Neuma — sovereign relationships with AI.",
  "homepage": "https://deusneuma.ai",
  "author": "Ignis AI Labs LLC <legal@ignislabs.ai>",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "neuma": "./bin/neuma"
  },
  "scripts": {
    "_comment_abi": "pre* hooks keep better-sqlite3's native ABI matched to the runtime (node for tests/dev, electron for the app). Marker-cached, so a no-op when already correct. See scripts/ensure-native-abi.mjs.",
    "prestart": "node scripts/ensure-native-abi.mjs node",
    "prebackend": "node scripts/ensure-native-abi.mjs node",
    "predev": "node scripts/ensure-native-abi.mjs node && node scripts/native-abi-cache.mjs harvest",
    "predev:backend": "node scripts/ensure-native-abi.mjs node && node scripts/native-abi-cache.mjs harvest",
    "predev:debug": "node scripts/ensure-native-abi.mjs node",
    "pretest": "node scripts/ensure-native-abi.mjs node",
    "pretest:unit": "node scripts/ensure-native-abi.mjs node",
    "pretest:integration": "node scripts/ensure-native-abi.mjs node",
    "pretest:watch": "node scripts/ensure-native-abi.mjs node",
    "pretest:coverage": "node scripts/ensure-native-abi.mjs node",
    "preelectron:dev": "node scripts/ensure-native-abi.mjs electron && node scripts/native-abi-cache.mjs harvest",
    "preelectron:build": "node scripts/ensure-native-abi.mjs electron",
    "pretest:e2e:electron": "node scripts/ensure-native-abi.mjs electron",
    "start": "node scripts/run-with-pipeline-ports.mjs node backend/server.js",
    "dev": "node scripts/run-with-pipeline-ports.mjs concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node scripts/run-with-pipeline-ports.mjs node --watch-path=./backend --watch-path=./core backend/server.js",
    "dev:frontend": "node scripts/run-with-pipeline-ports.mjs vite",
    "build": "vite build",
    "bake-sounds": "node scripts/bake-sounds.mjs",
    "migrate:dek": "node scripts/migrate-to-per-neuma-dek.js",
    "preview": "node scripts/run-with-pipeline-ports.mjs vite preview",
    "web": "vite build && node scripts/run-with-pipeline-ports.mjs node scripts/launch-web.mjs",
    "web:serve": "node scripts/run-with-pipeline-ports.mjs node scripts/launch-web.mjs",
    "backend": "node scripts/run-with-pipeline-ports.mjs node backend/server.js",
    "frontend": "node scripts/run-with-pipeline-ports.mjs vite",
    "test": "vitest run",
    "test:unit": "vitest run test/unit/",
    "test:integration": "vitest run test/integration/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:desk": "playwright test test/e2e/desk.spec.js",
    "brand:card": "node scripts/render-card.mjs",
    "brand:sheet": "node scripts/brand-review-sheet.mjs",
    "test:e2e:queue": "playwright test test/e2e/queue-decisions.spec.js",
    "test:e2e:wallet": "playwright test test/e2e/wallet-policy.spec.js",
    "test:e2e:electron": "npm run build && playwright test test/e2e/electron-birth.spec.js",
    "dev:debug": "node scripts/run-with-pipeline-ports.mjs node --inspect={NEUMA_DEBUG_PORT} --watch-path=./backend --watch-path=./core backend/server.js",
    "electron:dev": "npm run build && node scripts/run-with-pipeline-ports.mjs electron . --ozone-platform=x11",
    "electron:build": "npm run build && electron-builder",
    "predist:linux": "node scripts/ensure-native-abi.mjs electron",
    "dist:linux": "npm run build && electron-builder --linux",
    "predist:rpm": "node scripts/ensure-native-abi.mjs electron",
    "dist:rpm": "npm run build && electron-builder --linux dir && node scripts/build-rpm.mjs",
    "predist:deb": "node scripts/ensure-native-abi.mjs electron",
    "dist:deb": "npm run build && electron-builder --linux dir && node scripts/build-deb.mjs",
    "prepare": "git config core.hooksPath \"$(cd \"$(git rev-parse --path-format=absolute --git-common-dir)/..\" && pwd)/scripts/git-hooks\" 2>/dev/null || true",
    "postinstall": "node scripts/native-abi-cache.mjs harvest --never-fail && node scripts/patch-typeless-deps.mjs && node scripts/patch-nsis-template.mjs",
    "native:abi": "node scripts/native-abi-cache.mjs status",
    "lint": "eslint backend/ core/ frontend/ --ext .js,.cjs,.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/state": "6.6.0",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server-filesystem": "2026.7.10",
    "@modelcontextprotocol/server-memory": "2026.8.31",
    "@pixiv/three-vrm": "3.5.3",
    "@supabase/supabase-js": "2.95.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.20.0",
    "astronomy-engine": "2.1.19",
    "better-sqlite3": "12.11.1",
    "codemirror": "6.0.2",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "electron-updater": "6.8.9",
    "ethers": "6.17.0",
    "express": "4.22.3",
    "highlight.js": "11.11.1",
    "i18next": "26.4.2",
    "js-yaml": "4.3.2",
    "markdown-it": "14.3.3",
    "multer": "2.5.0",
    "node-fetch": "3.3.2",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.2.108",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.15",
    "react-markdown": "9.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.184.0",
    "wordnet-db": "3.1.14",
    "ws": "8.22.0",
    "yargs": "18.0.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "express@4.22.3": {
      "body-parser": "1.20.9"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "4.1.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.0.18",
    "chalk": "5.6.0",
    "concurrently": "8.2.2",
    "electron": "44.9.0",
    "electron-builder": "25.1.8",
    "eslint": "10.10.0",
    "eslint-plugin-jsdoc": "64.3.6",
    "natural": "8.1.0",
    "supertest": "7.2.2",
    "vite": "5.4.19",
    "vitest": "4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ignis-AI-Labs/deus-neuma.git"
  }
}
