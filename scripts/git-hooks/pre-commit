#!/bin/sh
# pre-commit — two gates, in order (one-time enable: git config core.hooksPath
# scripts/git-hooks; `npm install` sets it too — see package.json "prepare").
#   1. SECRET GATE: no live secret or key-shaped value enters history
#      (scripts/secret-gate.mjs; why: commit 422f95aff, 2026-04-14).
#   2. SIZE LAW: staged files judged against the frozen baseline.
# Then `git lfs install` so the lfs hooks follow the hooksPath.
# The gate is found beside this hook, not in the checkout: core.hooksPath is
# absolute, so every worktree (even one checked out at an older commit) runs
# the main checkout's current gate.
here="$(cd "$(dirname "$0")" && pwd)"
node "$here/../secret-gate.mjs" --staged || exit 1
root="$(git rev-parse --show-toplevel)"
[ -f "$root/scripts/check-file-size.mjs" ] || exit 0
exec node "$root/scripts/check-file-size.mjs" --staged
