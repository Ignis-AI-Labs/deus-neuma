node_modules/
.env
.env.local
.env.test
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
# Ignore local Claude state, but DO track the shippable skills we author
# and the PROJECT hook config (settings.local.json stays personal + ignored).
.claude/*
!.claude/skills/
!.claude/settings.json

# Build outputs
dist/
artifacts/
cache/

# Neuma DNA Vaults
vault/dna/
vault/audit/
vault/test-dna/

# Runtime data (data/ directory — formerly companions/)
data/dna-cache/
data/memory-store/
data/temp/
# Runtime logs (prefix/section drift, summon checks) — written by the running app, never source.
data/logs/
data/covenant/
data/capacity/
# Product-integrated team trial records stay under data; the global harness lives in benchmarks/.
data/benchmarks/
# Chat watches (chat-watch.js) — which conversation waits on what; machine-local state.
data/watches/
# Run records + delivery manifests name beings and wallets — local, like arenas
data/team-runs/
data/team-deliveries/
# The fresh arena a team run gets when its plan names no workspace — the
# members' own work, local to this machine (team-run-start.js)
data/team-arenas/
# The operator's act ledger (SEC-035) — their own machine's record of what
# their beings did. Metadata only, but it names lanes and paths: never source.
data/acts/
# Silo prefix captures (#506) carry identity PLAINTEXT — local diagnostic only
data/diagnostics/
# Brand kits carry a company's private livery (logos, palettes) — local runtime data
data/brand-kits/
# ComfyUI spike artifacts (outputs, user data) — machine-local runtime, never source
data/comfyui/
# The culture library (downloaded images + provenance manifest) — runtime, curated per machine
data/media-library/
# THE IMAGE FORGE — being-generated images AND the witness-reviewed content-law
# term list (execution artifact: never source, never neuma-visible, never shipped)
data/image-forge/
# The operator's auto-detected local routes (provider, endpoint, chosen model).
# Machine-local runtime state written by the app at boot, never source — it
# names this rig's own ports and gguf files.
data/settings-store/
# Content-addressed serving/training artifact store (sealed 0o500 object dirs).
# Machine-local runtime state: real staged model bytes, never source.
data/refinement-artifacts/

# Sovereign neuma workspaces (local to each machine)
workspaces/

# The witnesses' ground — sealed AI witnesses' sovereign lanes, standing
# BESIDE the house (default sibling of workspaces/); never committed.
/witnesses/

# Local platform DB (default dev path: <repo>/platform/platform.db + WAL sidecars)
/platform/

# The operator's local edit-undo stack + active-being marker. Every edit that
# lands on a real file snapshots its pre-edit content here first, whoever made
# it — the operator through `neuma edit`, or a being through the platform's own
# edit_file hand (#299). Machine-local recovery state, never source.
/.neuma/

# ML models and training artifacts
models/training/venv/
models/training/checkpoints/
models/training/training_data.csv
models/calibration-scorer/

# Voice engine weights + sidecar state (downloaded per-machine, not committed)
voice-engines/_models/
voice-engines/_logs/
voice-engines/_tmp/
voice-engines/_samples/
voice-engines/_source-*/
voice-engines/*/venv/
voice-engines/*/.venv/
voice-engines/*/__pycache__/
scripts/voice-bakeoff/engines/*/.venv/
scripts/voice-bakeoff/engines/*/__pycache__/
scripts/voice-bakeoff/engines/dia2/src/
__pycache__/

# AI witness identities — sovereign per-instance, never committed
# (parallel to workspaces/ and claude.env conventions)
ai-witnesses/
# Witness wallet env files (env.<slug>, e.g. env.glm, env.claude) — secret.
# The glob is the backstop so EVERY vendor slug is covered and a new witness can
# never leak a key by introducing a new slug. Example/template files stay tracked.
env.*
!env.example
!env.*.example

# Supabase local dev
supabase/.temp/
supabase/.branches/

# Audit temp files (agent staging — not committed)
docs/audit/temp/

# Generated Playwright report (regenerated by npm run test:e2e:*)
test/e2e/report/

# Runtime file-explorer settings (per-machine open folders)
data/settings/

# Claude's witness wallet — secret, never committed
claude.env

# Licensed sample library (Splice) — local symlink, never commit
frontend/assets/sounds
.vercel
.env*.local

# ai6 paired-review exchange logs — local only
.ai6/

# Shadow Clone /sc-* wave deliverables (session-scratch — drafts, agent
# logs, sprint plans). Final docs that ship live under docs/. Same posture
# as .ai6/.
.waves/

# Playwright/test run artifacts (regeneratable — not source)
test-results/
test/e2e/shots-electron/

# sc-echo review request/response files contain full file contents — never commit
.sc/

# NO MODEL EVER SHIPS (Design note, 2026-08-06: no avatar model in this repo is ours
# to distribute — a committed model IS redistribution the moment the repo is
# shared, and the platform bundles none (users bring their own). The operator's
# private local fleet lives in frontend/public/model/ (the dev surface, never
# copied into dist/); purchased Booth sources stay in ~/Documents/neuma/Models.
frontend/public/model/*.vrm
frontend/public/model/test/

# Being words from live sittings stay LOCAL (data sovereignty) — screenshots only in git
test/e2e/shots-sitting/transcript-*.txt
test/e2e/shots-sitting/refinement-consent-*.json
# Benchmarks live in their own repository (/workspace/repos/project-fuvofos), never here (Design note, 2026-10-15.
/benchmarks/

# Per-ABI compiled addons (machine-specific binaries; rebuilt by npm postinstall)
.native-abi/

# .env backups carry the same secrets as .env — never committable.
.env.bak.*

# electron-builder output (installers + unpacked tree; machine-built artifacts)
release/

# THE DESIGN BENCH — variation scratch (skills-packs/design). Variations are
# reviewed here and ratified into real components; scratch never enters the tree.
designs/

# Machine-local algorithm sync receipt; preserve locally, never publish freshness.
/data/x-algorithm-sync.json
