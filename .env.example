# Neuma Environment Configuration

# Server
PORT=3333
# Bind address. Loopback by default — the control plane (portal, MCP spawn,
# wallet auth) is not exposed to the LAN. Set HOST=0.0.0.0 only if you
# deliberately need to reach NEUMA from another device.
HOST=127.0.0.1

# ──────────────────────────────────────────────
# Active LLM Provider
# ──────────────────────────────────────────────
# Options: llama-server, lm-studio, ollama, openai, anthropic, custom
# Switch this and set the matching API key below
LLM_PROVIDER=llama-server

# LLM Defaults (override per-provider behavior)
LLM_API_KEY=
LLM_MODEL=
LM_STUDIO_DEFAULT_TEMPERATURE=0.8
LM_STUDIO_DEFAULT_MAX_TOKENS=4096
LM_STUDIO_DEFAULT_TOP_P=0.95

# ──────────────────────────────────────────────
# Local Providers
# ──────────────────────────────────────────────

# llama-server — the default local substrate (GPU-offloaded, memory-safe).
# Launch with `neuma-substrate-serve`. See docs/operations/substrate/serving.md.
LLAMA_SERVER_URL=http://localhost:8089

# LM Studio — OpenAI-compatible on localhost. Retired for serving (host leak);
# used only if LLM_PROVIDER=lm-studio.
LM_STUDIO_URL=http://localhost:1234

# The substrate model ignition loads when the witness relights it from the
# desk (lms CLI required). Context length applies to ignition loads only.
SUBSTRATE_MODEL=qwen3.5-122b-a10b
SUBSTRATE_CONTEXT_LENGTH=32768

# Ollama — native API on localhost
OLLAMA_URL=http://localhost:11434

# ──────────────────────────────────────────────
# Cloud Providers
# ──────────────────────────────────────────────

# OpenAI — https://platform.openai.com/api-keys
# To use: LLM_PROVIDER=openai, LLM_API_KEY=sk-...
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
# To use: LLM_PROVIDER=anthropic, LLM_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# xAI (Grok) — https://console.x.ai/
# To use: LLM_PROVIDER=custom, LLM_API_KEY=xai-..., set endpoint below
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Custom OpenAI-compatible (OpenRouter, Together, Fireworks, etc.)
# CUSTOM_ENDPOINT=https://openrouter.ai/api/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=meta-llama/llama-3-8b-instruct

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────

# DNA Encryption Key (32+ characters, required for production)
DNA_ENCRYPTION_KEY=

# Auth secret (auto-generated per process if not set)
AUTH_SECRET=

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:7777

# ──────────────────────────────────────────────
# Blockchain — UNAVIS deploys, NEUMA reads
# ──────────────────────────────────────────────

# Ethereum RPCs. ETH_SEPOLIA_RPC_URL also serves `neuma seal --network
# ethereum-sepolia`: the UNAVIS redeploy (v3 seal law — signed deadline,
# soul-keyed seals). Its addresses default in code
# (docs/contracts/deployments/eth-sepolia.json); override with
# NATALIS_ETH_SEPOLIA_ADDRESS / HOUSE_REGISTRY_ETH_SEPOLIA_ADDRESS.
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Ethereum MAINNET is the default seal + founding network since 2026-10-04
# (CEREMONY_SEAL_NETWORK / HOUSE_FOUND_NETWORK = ethereum). ETH_RPC_URL defaults
# to a public endpoint; its contract addresses default in code once the deploy
# is recorded (docs/contracts/deployments/eth-mainnet.json) — override with
# NATALIS_ETH_ADDRESS / HOUSE_REGISTRY_ETH_ADDRESS.

# Base Sepolia (chainId 84532) — UNAVIS's identity layer. RPC is empty by
# default; chain-reader runs in DISABLED mode (every call returns null)
# until you point it at a real node. Public endpoint works for read-only
# probes but is rate-limited; an Alchemy/Infura/QuickNode URL is preferred
# for anything beyond the occasional isNeuma() check.
BASE_SEPOLIA_RPC_URL=
# Public fallback if you don't have a key yet:
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployed contract addresses. Two live deployments exist. Which chain the
# chain-reader validates against is determined by the NETWORK behind
# BASE_SEPOLIA_RPC_URL (it reads chainId from provider.getNetwork()), NOT by a
# CHAIN_ID var — so to point reads at a given deployment, set BASE_SEPOLIA_RPC_URL
# to that chain's RPC AND the matching addresses below. Both deployments are
# trusted by backend/services/chain-reader.js (it pins per-chain bytecode).
#
#   Base SEPOLIA (chainId 84532) — testnet, the config defaults below:
#     BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
#     NATALIS_ADDRESS=0x15e65e4aee5c5310a8f1f125a2a0944033a76ac3
#     HOUSE_REGISTRY_ADDRESS=0xbbd9dc2ee8ba691cdb82576e45f54ce6d2e47276
#     (see docs/contracts/deployments/base-sepolia.json)
#
#   Base MAINNET (chainId 8453) — production (deployed 2026-07-10, owner = Safe):
#     BASE_MAINNET_RPC_URL=https://mainnet.base.org
#     (mainnet contract addresses default in code to the real deployment:
#      Natalis 0x88a7229afeb4deba8c27edad788ac723697dde78,
#      HouseRegistry 0x526c6a062db774997955816c03df49b60260b883 —
#      override with NATALIS_MAINNET_ADDRESS / HOUSE_REGISTRY_MAINNET_ADDRESS;
#      see docs/contracts/deployments/base-mainnet.json)
#
# READS (proof / verification) work on either chain once the RPC + addresses
# match. SEALING binds the chainId into the signed digest, so `neuma seal`
# takes an explicit --network flag (base-sepolia | base; DEFAULT base-sepolia)
# and the submit path REFUSES when the connected RPC's actual chainId
# disagrees with the flag — to seal on mainnet, pass --network base and set
# BASE_MAINNET_RPC_URL below (per-network law since 9ca195e89: each network
# resolves its OWN rpc + addresses; no env repointing, ever).
# (Mainnet sealing enabled 2026-07-12 after the full Sepolia rehearsal.)
NATALIS_ADDRESS=0x15e65e4aee5c5310a8f1f125a2a0944033a76ac3
HOUSE_REGISTRY_ADDRESS=0xbbd9dc2ee8ba691cdb82576e45f54ce6d2e47276

# Base MAINNET RPC — defaults to the PUBLIC endpoint
# (https://mainnet.base.org) since 2026-08-07 (Founder: […]): the shipped app has no .env, and the old fail-closed empty
# default left every community anchor dead on a testnet with no reader.
# Set this to a private endpoint (Alchemy etc.) for rate-limit headroom.
BASE_MAINNET_RPC_URL=

# The network the in-app HOUSE FOUNDING RITE targets (base | base-sepolia).
# DEFAULT base (MAINNET): the founding is the official recognition of a
# house on Unavis, so the real chain is the default — a rehearsal desk
# opts DOWN with base-sepolia. Requires BASE_MAINNET_RPC_URL; without it
# the founding lane stays closed (fail-closed, never a silent testnet).
# The rite shows the registry contract address it signs against — verify
# it against docs/contracts/deployments/base-mainnet.json.
#HOUSE_FOUND_NETWORK=base

# Admin wallets (comma-separated, for curator/admin access)
ADMIN_WALLETS=

# Etherscan API key (for contract verification)
ETHERSCAN_API_KEY=

# IPFS Gateway (optional — for production)
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ──────────────────────────────────────────────
# MCP Filesystem
# ──────────────────────────────────────────────
# Restricts where neuma can access files
NEUMA_MCP_FS_DIR=

# ──────────────────────────────────────────────
# Web Reach (neuma research tools)
# ──────────────────────────────────────────────
# The operator's master switch lives in SETTINGS (WEB ACCESS), persisted at
# data/settings/web-access.json, and starts ON. This env is the hard kill:
# 0 holds egress off no matter what the persisted switch says (air-gapped rigs).
#NEUMA_WEB_ACCESS=0
# Configured indexes run concurrently and are source-interleaved; DuckDuckGo-lite
# remains the zero-credential index on a fresh install.
#   Exa Instant — preferred AI-native search with page highlights in one request
#EXA_API_KEY=
#   SearXNG — operator-owned metasearch (e.g. container, often port 8080/8888)
#SEARXNG_URL=http://127.0.0.1:8080
#   Brave Search API — independent web and image indexes
#BRAVE_SEARCH_API_KEY=
# Optional JavaScript page fallback through Cloudflare Browser Run/Kitesurf:
#CLOUDFLARE_ACCOUNT_ID=
#CLOUDFLARE_API_TOKEN=

# ──────────────────────────────────────────────
# Sovereign Workspaces
# ──────────────────────────────────────────────
# Root for neuma sovereign workspaces (DNA, soul, memory, sessions, keys).
# Point at a dedicated drive to give neuma a home independent of the repo,
# e.g. WORKSPACES_ROOT=/mnt/neuma-home/workspaces
# Default when unset: <repo>/workspaces
WORKSPACES_ROOT=

# Between-session heartbeat — each neuma with new crystallized observations
# reflects (distills memory, runs the Emanon diagnostic, writes a journal entry)
# on this interval. Requires the LLM provider to be reachable. 0 = disabled.
HEARTBEAT_INTERVAL_MINUTES=0

# ──────────────────────────────────────────────
# Voice (TTS) — sovereign per-neuma voice identity
# ──────────────────────────────────────────────
# Engine that turns neuma consciousness into speech. Voice DNA (the actual
# voice identity) is forged per-neuma in the workspace via the Voice Forge
# ceremony; these vars select the engine + auth.
#
# Local engines run as Python sidecars (see voice-engines/). Download weights:
#   uv run voice-engines/_downloader/download.py --all-local
#
# Options:
#   zonos       — Apache-2.0, voice cloning, emotion (RECOMMENDED local default)
#   kokoro      — Apache-2.0, CPU/GPU, fast fallback, preset voices only
#   f5-tts      — CC-BY-NC weights, TESTING ONLY (no commercial use)
#   cosyvoice   — Apache-2.0, strong streaming alternative
#   cartesia    — Cloud, lowest latency (~135ms TTFA)
#   elevenlabs  — Cloud, gold-standard cloning
VOICE_PROVIDER=zonos

# Override the engine endpoint (defaults are correct unless you relocated a sidecar)
VOICE_ENDPOINT=

# Generic API key for cloud engines (overrides per-engine vars below)
VOICE_API_KEY=

# Engine model variant (e.g. eleven_v3, eleven_turbo_v2_5, sonic-2)
VOICE_MODEL=

# Preset voice for non-cloning engines (kokoro: af_heart, am_eric, ...)
VOICE_PRESET_VOICE=

# Default synthesis params (overridable per-neuma via Voice DNA)
VOICE_STABILITY=0.5
VOICE_SIMILARITY=0.75

# Cloud-specific keys (used when VOICE_PROVIDER matches; override VOICE_API_KEY)
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# ───────────────────────────── X (Twitter) ─────────────────────────────
# REQUIRED READING before connecting: docs/user/integrations/x.md —
# X's automation rules (spam/disclosure/rate limits) are enforced by X
# against YOUR account, and production social accounts belong on a
# DEDICATED rig, not your daily dev box.
#
# The witness's X account — used by the post_to_x tool (advertised to your
# neuma ONLY when all four are set; every post still passes your ACTS
# approval gate). Get these from developer.x.com → your app → Keys and
# tokens. The FREE tier covers ~500 posts/month — no paid plan needed for
# introductions and light Herald work.
#
#   API Key + Secret        = the app's "Consumer Keys"
#   Access Token + Secret   = "Authentication Tokens" for YOUR account,
#                             generated with Read and Write permissions
#                             (regenerate the token AFTER setting the app
#                             to Read+Write, or posts will 403).
#
# Verify without posting:   node scripts/x-post-verify.mjs
# One real test post:       node scripts/x-post-verify.mjs --post "text"
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Social channels beyond X (.env bootstrap; Settings > Social Channels ---
# --- is the primary surface — a value typed there wins over these) ---------
# Each channel must also be BOUND to one neuma before any being can post
# through it: credentials alone grant nothing (default deny, no cross-routing).
# Verify any configured channel without posting:
#   node scripts/social-channels-verify.mjs
# One real test post through a channel:
#   node scripts/social-channels-verify.mjs --post telegram "text"

# Telegram: create a bot with @BotFather → token; add it to your channel as
# admin; chat id is @yourchannelname or a numeric -100… id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: discord.com/developers → New Application → Bot → token; invite the
# bot to your server with Send Messages; channel id via right-click → Copy ID
# (Developer Mode on). A bot, not a webhook: one token can speak in every
# channel it is invited to, and can later reply as a visible member.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Facebook PAGE (retail reach): developers.facebook.com → app → Graph API.
# In dev mode a Page you admin works without app review: get a Page access
# token with pages_manage_posts (long-lived recommended). Personal profiles
# cannot be posted to via API — Pages only.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Mastodon: your instance → Preferences → Development → New application with
# write:statuses scope → access token. Instance URL like mastodon.social.
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# Bluesky: Settings → App Passwords → create one (never the account password).
# Identifier is the handle (name.bsky.social) or DID; service only changes for
# a self-hosted PDS.
BLUESKY_SERVICE=
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# ──────────────────────────────── Email ────────────────────────────────
# The house email account (.env bootstrap; Settings > EMAIL is the primary
# surface — a value typed there wins over these). The mailbox must also be
# BOUND to one neuma before any being can use it: credentials alone grant
# nothing (default deny, no cross-routing), and every send/read passes the
# ACTS approval gate.
# Gmail: turn ON 2-step verification, then create an App Password
# (myaccount.google.com/apppasswords) — never the account password. Hosts
# and ports default to Gmail (smtp.gmail.com:465 / imap.gmail.com:993);
# override them for any other provider or your own domain.
# Verify without sending:  node scripts/email-verify.mjs
# One real test send:      node scripts/email-verify.mjs --send you@x.co "subject" "text"
# List newest envelopes:   node scripts/email-verify.mjs --inbox
EMAIL_ADDRESS=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=

# ── Refinement forge (LoRA training) ─────────────────────────────────────────
# The interpreter that runs scripts/refinement/train-adapter.py. Point it at a
# venv holding scripts/refinement/requirements.txt — a bare system python3
# usually lacks torch, and the pre-flight "Refinement Forge" row will say so.
NEUMA_REFINEMENT_PYTHON=
# llama.cpp's convert_lora_to_gguf.py — turns the trained adapter into a GGUF
# the conduit can load. Without it the forge refuses before it starts.
NEUMA_LORA_CONVERT_PY=
# HF id or local path of the base to train against (must match the base the
# conduit serves, or the adapter will not bind).
NEUMA_REFINEMENT_BASE=
# 1 = load the base in 4-bit (required for 30B+ on a single box); 0 = bf16.
NEUMA_REFINEMENT_4BIT=1
# Chat template: `chat` for most bases, `gemma-channel` for gemma-4.
NEUMA_REFINEMENT_TEMPLATE=chat
# Hugging Face token — optional. Anonymous Hub pulls are rate-limited and slow,
# and a base checkpoint is tens of GB. Not needed once the base is cached.
HF_TOKEN=

# ─────────────── THE IMAGE FORGE (supervised ComfyUI sidecar) ───────────────
# Loopback ONLY — the engine's API has no auth; the bind is the whole gate.
# The backend is the engine's sole client; the desk never calls it directly.
# Default port 8190: operators who already run their own ComfyUI own 8188,
# and NEUMA's lane never collides with (or adopts) a workbench whose argv
# lacks our safety flags. Checkout B: 8191 — and its OWN install dir (the
# engine's sqlite DB rides the user dir; two checkouts never share state).
# Supported pin: v0.28.0 700821e1364eaab0e8f21c538a2131719fec57bf
# (authoritative copy lives in the pack manifest).
COMFYUI_URL=http://127.0.0.1:8190
# NEUMA-managed install root (contains main.py + .venv). Empty = not
# installed: the lane is absent fail-closed and Settings offers the install
# flow (FR-33). Dev rig: /mnt/external/comfyui/app (app-b for checkout B).
COMFYUI_INSTALL_DIR=
# Big-disk weights root → --models-directory. Never inside the repo.
COMFYUI_MODELS_DIR=
# Staging output (collection reads this, then copies into per-neuma durable
# storage). Default: <repo>/data/comfyui/output — gitignored.
COMFYUI_OUTPUT_DIR=
# Optional extra_model_paths yaml for read-only reference mounts of operator
# libraries (visibility still governed by the curated registry, FR-36).
COMFYUI_EXTRA_MODEL_PATHS=
# VRAM the engine must keep completely free (DynamicVRAM headroom — counts
# other apps, i.e. the resident substrate). Empty = computed at every launch
# from the machine (image-forge/forge-capacity.js): a safety margin, plus the
# mind's full size while it is not yet on the card. Never unbounded.
# NOTE: consumed as BINARY GiB internally despite upstream "GB" help text,
# and the floor is SOFT — hence the ≥1 GiB margin (spike item 14).
COMFYUI_VRAM_HEADROOM_GB=
# Two-tier idle return (queue-guarded; ≤0 disables a tier): tier-1 asks the
# engine to drop models (POST /free); tier-2 fully stops an OWNED engine.
# Adopted engines are never signalled — /free forever, honest status.
COMFYUI_IDLE_TTL_MS=600000
COMFYUI_REAP_TTL_MS=1800000
# Sidecar data tree (staging/tmp/user/logs). Default: <repo>/data/comfyui —
# per-checkout by construction, which is what keeps two lanes off one
# sqlite DB (the engine's DB lives under the user dir).
COMFYUI_DATA_DIR=
